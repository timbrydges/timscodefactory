{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tims-software-factory.local/schemas/sandbox-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "task_id",
    "lease_id",
    "role_id",
    "source_commit",
    "command_digest",
    "environment_digest",
    "runner_identity",
    "sandbox_id",
    "started_at",
    "finished_at",
    "exit_code",
    "timed_out",
    "stdout_digest",
    "stderr_digest"
  ],
  "properties": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "lease_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "role_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runner_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sandbox_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "stdout_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stderr_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
