{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tims-software-factory.local/schemas/role-contract.schema.json",
  "title": "Tim's Software Factory role contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role_id", "contract_version", "allowed_states",
    "gate_authority", "allowed_tools", "github_permissions", "writable_paths",
    "prohibited_paths", "credential_profile", "provider_profile",
    "network_policy", "secret_policy", "authoritative_outputs",
    "stop_conditions", "identity_constraints"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "contract_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "allowed_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "gate_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_approve", "may_reject", "may_dispatch", "may_pause"],
      "properties": {
        "may_approve": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "may_reject": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "may_dispatch": {"type": "boolean"},
        "may_pause": {"type": "boolean"}
      }
    },
    "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "github_permissions": {
      "type": "object",
      "additionalProperties": {"enum": ["none", "read", "write"]}
    },
    "writable_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "prohibited_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "credential_profile": {"type": "string"},
    "provider_profile": {"type": ["string", "null"]},
    "network_policy": {"type": "string"},
    "secret_policy": {"type": "string"},
    "authoritative_outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "identity_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative_identity", "cannot_review_own_work", "lease_required", "evidence_provenance_required"],
      "properties": {
        "authoritative_identity": {"type": "string"},
        "cannot_review_own_work": {"type": "boolean"},
        "lease_required": {"type": "boolean"},
        "evidence_provenance_required": {"type": "boolean"},
        "must_differ_from": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "owner_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ultimate_authority", "approval_required", "may_approve_own_changes",
        "may_bypass_all_gates", "may_intervene_at_any_stage", "may_pause_or_stop",
        "may_resume", "may_override_all_agents", "owner_actions_audited",
        "authority_delegable"
      ],
      "properties": {
        "ultimate_authority": {"const": true},
        "approval_required": {"const": false},
        "may_approve_own_changes": {"const": true},
        "may_bypass_all_gates": {"const": true},
        "may_intervene_at_any_stage": {"const": true},
        "may_pause_or_stop": {"const": true},
        "may_resume": {"const": true},
        "may_override_all_agents": {"const": true},
        "owner_actions_audited": {"const": true},
        "authority_delegable": {"const": false}
      }
    }
  }
}
