{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tims-software-factory.local/schemas/runtime-watch-evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_session_id",
    "task_id",
    "lease_id",
    "status",
    "reason_code",
    "controller_request",
    "runtime_action",
    "authoritative_recovery_count",
    "last_heartbeat_at",
    "last_progress_at",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "runtime_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "lease_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"enum": ["STARTING", "HEALTHY", "STALE", "STUCK", "DEAD", "LEASE_EXPIRED"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "controller_request": {"enum": ["NONE", "REQUEST_RUNTIME_RESTART", "REQUEST_CONTROLLER_STALL"]},
    "runtime_action": {"enum": ["NONE", "TERMINATE_SESSION"]},
    "authoritative_recovery_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "last_heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
    "last_progress_at": {"type": ["string", "null"], "format": "date-time"},
    "evaluated_at": {"type": "string", "format": "date-time"}
  }
}
