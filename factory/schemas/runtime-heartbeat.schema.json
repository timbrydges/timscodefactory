{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tims-software-factory.local/schemas/runtime-heartbeat.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "heartbeat_id",
    "runtime_session_id",
    "task_id",
    "lease_id",
    "role_id",
    "worker_identity",
    "source_commit",
    "heartbeat_sequence",
    "progress_sequence",
    "progress_digest",
    "observed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "heartbeat_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "runtime_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "lease_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "role_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "worker_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "heartbeat_sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "progress_sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "progress_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
