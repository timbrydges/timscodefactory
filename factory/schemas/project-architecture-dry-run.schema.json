{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timscodefactory.local/schemas/project-architecture-dry-run.schema.json",
  "title": "Project Architecture Dry Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_id", "contract_id", "status", "authoritative",
    "generated_by", "generated_on", "source_contract", "constraints", "components",
    "data_entities", "workflow_states", "workflow", "trust_boundaries", "threats",
    "acceptance_mapping", "rollback", "open_decisions", "remaining_gates",
    "owner_decision_required"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "status": {"const": "NON_AUTHORITATIVE_DRY_RUN_COMPLETE"},
    "authoritative": {"const": false},
    "generated_by": {"const": "codex_interactive_dry_run"},
    "generated_on": {"type": "string", "format": "date"},
    "source_contract": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "components": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/namedDescription"}},
    "data_entities": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/namedDescription"}},
    "workflow_states": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "workflow": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/workflowStep"}},
    "trust_boundaries": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/namedDescription"}},
    "threats": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/threat"}},
    "acceptance_mapping": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/acceptance"}},
    "rollback": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "open_decisions": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/namedDescription"}},
    "remaining_gates": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "owner_decision_required": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "effect"],
      "properties": {
        "decision": {"const": "APPROVE_ARCHITECTURE_AND_THREAT_MODEL"},
        "effect": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "namedDescription": {
      "type": "object", "additionalProperties": false, "required": ["id", "description"],
      "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}
    },
    "workflowStep": {
      "type": "object", "additionalProperties": false, "required": ["step", "actor", "action", "result"],
      "properties": {"step": {"type": "integer", "minimum": 1}, "actor": {"type": "string"}, "action": {"type": "string"}, "result": {"type": "string"}}
    },
    "threat": {
      "type": "object", "additionalProperties": false, "required": ["id", "threat", "control", "failure_mode"],
      "properties": {"id": {"type": "string"}, "threat": {"type": "string"}, "control": {"type": "string"}, "failure_mode": {"type": "string"}}
    },
    "acceptance": {
      "type": "object", "additionalProperties": false, "required": ["id", "components", "evidence"],
      "properties": {"id": {"pattern": "^BL-[0-9]{2}$"}, "components": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence": {"type": "string", "minLength": 1}}
    }
  }
}
