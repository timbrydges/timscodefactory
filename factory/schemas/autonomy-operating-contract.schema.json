{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tims-software-factory.local/schemas/autonomy-operating-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_version", "status", "approval", "provider", "acceptance_target", "limits", "authority", "activation", "stop_conditions", "prohibited_data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_id": {"const": "tims-factory-autonomy-acceptance-001"},
    "contract_version": {"const": "1.0"},
    "status": {"enum": ["OWNER_APPROVED_AWAITING_TECHNICAL_GATES", "ACTIVE", "PAUSED", "RETIRED"]},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_identity", "authority", "approved_on", "evidence"],
      "properties": {
        "owner_identity": {"const": "tim_brydges"},
        "authority": {"const": "factory_owner"},
        "approved_on": {"const": "2026-09-23"},
        "evidence": {"const": "factory/evidence/autonomy-financial-authorization-2026-09-23.json"}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "model_id", "target_alias", "credential_source", "direct_provider_credentials_in_roles"],
      "properties": {
        "family": {"const": "openai"},
        "model_id": {"const": "gpt-5.6-sol"},
        "target_alias": {"const": "coding_primary_sol_live"},
        "credential_source": {"const": "ephemeral_provider_broker_lease"},
        "direct_provider_credentials_in_roles": {"const": false}
      }
    },
    "acceptance_target": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_full_name", "repository_id", "visibility", "default_branch", "contract_path", "contract_commit", "contract_blob_sha", "contract_sha256", "task_id", "evidence"],
      "properties": {
        "repository_full_name": {"const": "timbrydges/tims-factory-autonomy-acceptance"},
        "repository_id": {"const": 1382496429},
        "visibility": {"const": "private"},
        "default_branch": {"const": "main"},
        "contract_path": {"const": ".factory/acceptance-contract.json"},
        "contract_commit": {"const": "fcb4c535d4ea00962b26db14f59e34917ef2389f"},
        "contract_blob_sha": {"const": "d07d12bf88c84a02f72bd7250808ec8b0c915f11"},
        "contract_sha256": {"const": "7ca5363f88bc43e31436e1c8640bb9516a705aa07dda82519a690a9301a9b9fa"},
        "task_id": {"const": "deterministic-text-fingerprint"},
        "evidence": {"const": "factory/evidence/autonomy-acceptance-repository-2026-09-23.json"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "maximum_total_cost", "maximum_cost_per_call", "maximum_provider_calls", "maximum_output_tokens_per_call", "maximum_automated_wall_clock_hours", "maximum_remediation_cycles"],
      "properties": {
        "currency": {"const": "USD"},
        "maximum_total_cost": {"const": "5.00"},
        "maximum_cost_per_call": {"const": "0.25"},
        "maximum_provider_calls": {"const": 3},
        "maximum_output_tokens_per_call": {"const": 4096},
        "maximum_automated_wall_clock_hours": {"const": 24},
        "maximum_remediation_cycles": {"const": 0}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["autonomous_task_progression", "schedule_activation", "provider_calls", "repository_writes", "infrastructure_changes", "production_release", "release_authority_identity"],
      "properties": {
        "autonomous_task_progression": {"const": "ALLOW_AFTER_ALL_GATES"},
        "schedule_activation": {"const": "ALLOW_AFTER_ALL_GATES"},
        "provider_calls": {"const": "ALLOW_AFTER_ALL_GATES"},
        "repository_writes": {"const": "DENY_UNTIL_EXACT_ACCEPTANCE_TASK"},
        "infrastructure_changes": {"const": "DENY_UNTIL_REVIEWED_DEPLOYMENT"},
        "production_release": {"const": "DENY"},
        "release_authority_identity": {"const": "tim_brydges"}
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["default", "all_gates_required", "verified_gates", "pending_gates"],
      "properties": {
        "default": {"const": "DENY"},
        "all_gates_required": {"const": true},
        "verified_gates": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/evidence"}},
        "pending_gates": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "stop_conditions": {"$ref": "#/$defs/nonemptyStrings"},
    "prohibited_data": {"$ref": "#/$defs/nonemptyStrings"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence"],
      "properties": {"evidence": {"type": "string", "minLength": 1}}
    },
    "nonemptyStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 10}
    }
  }
}
