{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Fresh bounded-review-001 permanent at-most-once provider claims. No workers, schedules, grants or model calls.",
  "Resources": {
    "ProviderClaims": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "tims-factory-bounded-review-001-attempts",
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          }
        ],
        "Tags": [
          {
            "Key": "Factory",
            "Value": "tims-software-factory"
          },
          {
            "Key": "Task",
            "Value": "bounded-review-001"
          },
          {
            "Key": "Purpose",
            "Value": "permanent-at-most-once-claims"
          }
        ]
      }
    }
  },
  "Outputs": {
    "ClaimsTableArn": {
      "Value": {
        "Fn::GetAtt": [
          "ProviderClaims",
          "Arn"
        ]
      }
    }
  }
}
