{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Three isolated Factory identity and model-free transport canaries; operational execution disabled. Metered Lambda/DynamoDB/log/S3 use.",
  "Parameters": {
    "ArtifactKey": {
      "Type": "String"
    },
    "ArtifactVersion": {
      "Type": "String"
    },
    "CodeSha256": {
      "Type": "String"
    },
    "ArtifactBucket": {
      "Type": "String",
      "Default": "tims-software-factory-666730517561-ca-central-1",
      "AllowedValues": [
        "tims-software-factory-666730517561-ca-central-1"
      ]
    },
    "EnableBuilderAcceptanceIam": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "EnableInspectorAcceptanceIam": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    }
  },
  "Conditions": {
    "BuilderAcceptanceIamEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableBuilderAcceptanceIam"
        },
        "true"
      ]
    },
    "InspectorAcceptanceIamEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableInspectorAcceptanceIam"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "RoleExecutions": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "tims-factory-role-executions",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "PlannerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/tims-factory-planner",
        "RetentionInDays": 14
      }
    },
    "PlannerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tims-factory-executor-planner",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "bounded-role-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "OwnSigningSession",
                  "Effect": "Allow",
                  "Action": [
                    "sts:AssumeRole"
                  ],
                  "Resource": "arn:aws:iam::666730517561:role/tims-factory-signing-planner"
                },
                {
                  "Sid": "OwnLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "arn:aws:logs:ca-central-1:666730517561:log-group:/aws/lambda/tims-factory-planner:*"
                },
                {
                  "Sid": "CanaryStateReadAndConditionsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": "arn:aws:dynamodb:ca-central-1:666730517561:table/tims-software-factory-state",
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "FACTORY#tims-software-factory#TASK#cloud-role-canary-*",
                        "FACTORY#tims-software-factory#TASK#SCOPE#OBJECTIVE#cloud-role-canary-*"
                      ]
                    }
                  }
                },
                {
                  "Sid": "OwnExecutionRecordsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "RoleExecutions",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ROLE#software_architect_service#FACTORY#tims-software-factory#TASK#cloud-role-canary-*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "PlannerFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "PlannerLogs"
      ],
      "Properties": {
        "FunctionName": "tims-factory-planner",
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "factory_runtime.lambda_role.handler",
        "Role": {
          "Fn::GetAtt": [
            "PlannerRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "MemorySize": 256,
        "Timeout": 60,
        "Environment": {
          "Variables": {
            "FACTORY_ROLE": "planner",
            "FACTORY_OPERATIONAL_EXECUTION_ENABLED": "false",
            "EXECUTION_TABLE": {
              "Ref": "RoleExecutions"
            }
          }
        },
        "Description": "Factory identity and durable model-free transport canaries; no operational model execution"
      }
    },
    "PlannerVersion": {
      "Type": "AWS::Lambda::Version",
      "Properties": {
        "FunctionName": {
          "Ref": "PlannerFunction"
        },
        "CodeSha256": {
          "Ref": "CodeSha256"
        }
      }
    },
    "BuilderLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/tims-factory-builder",
        "RetentionInDays": 14
      }
    },
    "BuilderRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tims-factory-executor-builder",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": {
          "Fn::If": [
            "BuilderAcceptanceIamEnabled",
            [
              "arn:aws:iam::666730517561:policy/tims-software-factory-acceptance-budget-builder"
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "bounded-role-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "OwnSigningSession",
                  "Effect": "Allow",
                  "Action": [
                    "sts:AssumeRole"
                  ],
                  "Resource": "arn:aws:iam::666730517561:role/tims-factory-signing-builder"
                },
                {
                  "Sid": "OwnLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "arn:aws:logs:ca-central-1:666730517561:log-group:/aws/lambda/tims-factory-builder:*"
                },
                {
                  "Sid": "CanaryStateReadAndConditionsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": "arn:aws:dynamodb:ca-central-1:666730517561:table/tims-software-factory-state",
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "FACTORY#tims-software-factory#TASK#cloud-role-canary-*",
                        "FACTORY#tims-software-factory#TASK#SCOPE#OBJECTIVE#cloud-role-canary-*"
                      ]
                    }
                  }
                },
                {
                  "Sid": "OwnExecutionRecordsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "RoleExecutions",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ROLE#engineering_agent_service#FACTORY#tims-software-factory#TASK#cloud-role-canary-*"
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "Fn::If": [
              "BuilderAcceptanceIamEnabled",
              {
                "PolicyName": "bounded-acceptance-builder",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Sid": "ReadAndGuardExactAcceptanceState",
                      "Effect": "Allow",
                      "Action": [
                        "dynamodb:GetItem",
                        "dynamodb:ConditionCheckItem"
                      ],
                      "Resource": "arn:aws:dynamodb:ca-central-1:666730517561:table/tims-software-factory-state",
                      "Condition": {
                        "ForAllValues:StringLike": {
                          "dynamodb:LeadingKeys": [
                            "FACTORY#tims-software-factory#TASK#deterministic-text-fingerprint",
                            "FACTORY#tims-software-factory#TASK#SCOPE#OBJECTIVE#*"
                          ]
                        }
                      }
                    },
                    {
                      "Sid": "OwnExactAcceptanceExecution",
                      "Effect": "Allow",
                      "Action": [
                        "dynamodb:GetItem",
                        "dynamodb:PutItem",
                        "dynamodb:UpdateItem"
                      ],
                      "Resource": {
                        "Fn::GetAtt": [
                          "RoleExecutions",
                          "Arn"
                        ]
                      },
                      "Condition": {
                        "ForAllValues:StringEquals": {
                          "dynamodb:LeadingKeys": [
                            "ROLE#engineering_agent_service#FACTORY#tims-software-factory#TASK#deterministic-text-fingerprint"
                          ]
                        }
                      }
                    },
                    {
                      "Sid": "InvokePinnedCredentialFreeBroker",
                      "Effect": "Allow",
                      "Action": [
                        "lambda:InvokeFunction"
                      ],
                      "Resource": "arn:aws:lambda:ca-central-1:666730517561:function:tims-factory-provider-broker:3"
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      }
    },
    "BuilderFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "BuilderLogs"
      ],
      "Properties": {
        "FunctionName": "tims-factory-builder",
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "factory_runtime.lambda_role.handler",
        "Role": {
          "Fn::GetAtt": [
            "BuilderRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "MemorySize": 256,
        "Timeout": 60,
        "Environment": {
          "Variables": {
            "FACTORY_ROLE": "builder",
            "FACTORY_OPERATIONAL_EXECUTION_ENABLED": "false",
            "EXECUTION_TABLE": {
              "Ref": "RoleExecutions"
            }
          }
        },
        "Description": "Factory identity and durable model-free transport canaries; no operational model execution"
      }
    },
    "BuilderVersion": {
      "Type": "AWS::Lambda::Version",
      "Properties": {
        "FunctionName": {
          "Ref": "BuilderFunction"
        },
        "CodeSha256": {
          "Ref": "CodeSha256"
        }
      }
    },
    "InspectorLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/tims-factory-inspector",
        "RetentionInDays": 14
      }
    },
    "InspectorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "tims-factory-executor-inspector",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "bounded-role-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "OwnSigningSession",
                  "Effect": "Allow",
                  "Action": [
                    "sts:AssumeRole"
                  ],
                  "Resource": "arn:aws:iam::666730517561:role/tims-factory-signing-inspector"
                },
                {
                  "Sid": "OwnLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "arn:aws:logs:ca-central-1:666730517561:log-group:/aws/lambda/tims-factory-inspector:*"
                },
                {
                  "Sid": "CanaryStateReadAndConditionsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": "arn:aws:dynamodb:ca-central-1:666730517561:table/tims-software-factory-state",
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "FACTORY#tims-software-factory#TASK#cloud-role-canary-*",
                        "FACTORY#tims-software-factory#TASK#SCOPE#OBJECTIVE#cloud-role-canary-*"
                      ]
                    }
                  }
                },
                {
                  "Sid": "OwnExecutionRecordsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "RoleExecutions",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ROLE#independent_inspector_service#FACTORY#tims-software-factory#TASK#cloud-role-canary-*"
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "Fn::If": [
              "InspectorAcceptanceIamEnabled",
              {
                "PolicyName": "acceptance-inspector-fallback-sonnet-4-5",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Sid": "ExactInspectorProfile",
                      "Effect": "Allow",
                      "Action": "bedrock:InvokeModel",
                      "Resource": "arn:aws:bedrock:ca-central-1:666730517561:inference-profile/global.anthropic.claude-sonnet-4-5-20250929-v1:0",
                      "Condition": {
                        "StringEquals": {
                          "aws:RequestedRegion": "ca-central-1"
                        }
                      }
                    },
                    {
                      "Sid": "RegionalModelOnlyViaInspectorProfile",
                      "Effect": "Allow",
                      "Action": "bedrock:InvokeModel",
                      "Resource": "arn:aws:bedrock:ca-central-1::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
                      "Condition": {
                        "StringEquals": {
                          "aws:RequestedRegion": "ca-central-1",
                          "bedrock:InferenceProfileArn": "arn:aws:bedrock:ca-central-1:666730517561:inference-profile/global.anthropic.claude-sonnet-4-5-20250929-v1:0"
                        }
                      }
                    },
                    {
                      "Sid": "GlobalModelOnlyViaInspectorProfile",
                      "Effect": "Allow",
                      "Action": "bedrock:InvokeModel",
                      "Resource": "arn:aws:bedrock:::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
                      "Condition": {
                        "StringEquals": {
                          "aws:RequestedRegion": "unspecified",
                          "bedrock:InferenceProfileArn": "arn:aws:bedrock:ca-central-1:666730517561:inference-profile/global.anthropic.claude-sonnet-4-5-20250929-v1:0"
                        }
                      }
                    },
                    {
                      "Sid": "ReserveExactInspectorReview",
                      "Effect": "Allow",
                      "Action": [
                        "dynamodb:PutItem"
                      ],
                      "Resource": "arn:aws:dynamodb:ca-central-1:666730517561:table/tims-factory-acceptance-budget",
                      "Condition": {
                        "ForAllValues:StringEquals": {
                          "dynamodb:LeadingKeys": [
                            "INSPECTOR#inspector-fallback-2026-10-01-006"
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      }
    },
    "InspectorFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "InspectorLogs"
      ],
      "Properties": {
        "FunctionName": "tims-factory-inspector",
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "factory_runtime.lambda_role.handler",
        "Role": {
          "Fn::GetAtt": [
            "InspectorRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "MemorySize": 256,
        "Timeout": 120,
        "Environment": {
          "Variables": {
            "FACTORY_ROLE": "inspector",
            "FACTORY_OPERATIONAL_EXECUTION_ENABLED": "false",
            "EXECUTION_TABLE": {
              "Ref": "RoleExecutions"
            }
          }
        },
        "Description": "Factory identity and durable model-free transport canaries; no operational model execution"
      }
    },
    "InspectorVersion": {
      "Type": "AWS::Lambda::Version",
      "Properties": {
        "FunctionName": {
          "Ref": "InspectorFunction"
        },
        "CodeSha256": {
          "Ref": "CodeSha256"
        }
      }
    },
    "ControllerInvoke": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "factory-isolated-role-versions",
        "Roles": [
          "tims-software-factory-github-controller"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "lambda:InvokeFunction"
              ],
              "Resource": [
                {
                  "Ref": "PlannerVersion"
                },
                {
                  "Ref": "BuilderVersion"
                },
                {
                  "Ref": "InspectorVersion"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "PlannerVersionArn": {
      "Value": {
        "Ref": "PlannerVersion"
      }
    },
    "BuilderVersionArn": {
      "Value": {
        "Ref": "BuilderVersion"
      }
    },
    "InspectorVersionArn": {
      "Value": {
        "Ref": "InspectorVersion"
      }
    }
  }
}
